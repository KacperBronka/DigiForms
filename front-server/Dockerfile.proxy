FROM nginx:1.28.0-alpine3.21

ENV RATE_LIMIT_RPS=10 \
    RATE_LIMIT_BURST=20 \
    UPLOAD_RATE_LIMIT_RPM=5 \
    UPLOAD_RATE_LIMIT_BURST=2 \
    NGINX_ENVSUBST_OUTPUT_DIR=/tmp/nginx-conf \
    NGINX_ENVSUBST_FILTER="^(RATE_LIMIT_|UPLOAD_RATE_LIMIT_)"

# Run the master and workers as nginx, with writable temporary paths.
RUN sed -i '/^user /d; s@/var/run/nginx.pid@/tmp/nginx.pid@; s@/etc/nginx/conf.d/\*.conf@/tmp/nginx-conf/*.conf@' /etc/nginx/nginx.conf && \
    chown -R nginx:nginx /var/cache/nginx /etc/nginx/conf.d
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY --chmod=755 nginx-validate-env.sh /docker-entrypoint.d/19-validate-rate-limits.sh
USER nginx
CMD ["nginx", "-g", "daemon off;"]
