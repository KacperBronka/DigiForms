# Runtime only. Copy to .env locally and provide your own key; never commit .env.
EDENAI_API_KEY=
MAX_UPLOAD_BYTES=20971520
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
PARSER_TMP_SIZE=1g
OCR_CACHE_SIZE=2g

# Eden AI integration (runtime only)
EDENAI_API_URL=https://api.edenai.run/v3/chat/completions
EDENAI_MODEL=amazon/anthropic.claude-haiku-5-5@eu
EDENAI_CONNECT_TIMEOUT_SECONDS=15
EDENAI_READ_TIMEOUT_SECONDS=600

# Parser integration; this URL is for Compose. Outside Docker use localhost:3001/upload.
DOCUMENT_PROCESSOR_URL=http://app:3000/upload
DOCUMENT_PROCESSOR_TIMEOUT_SECONDS=900
# Optional service JWT; leave empty to forward the caller's Authorization header.
DOCUMENT_PROCESSOR_TOKEN=

# JWT verification. No signing private key is needed by this application.
JWT_ENABLED=false
JWT_ALGORITHM=RS256
JWT_ISSUER=
JWT_AUDIENCE=
# PEM public key; literal backslash-n sequences are accepted between lines.
JWT_PUBLIC_KEY=
JWT_LEEWAY_SECONDS=30

# OCR and model input limits
OCR_LANG=pl
OCR_VERSION=PP-OCRv6
OCR_DEVICE=cpu
MAX_OCR_CHARS=160000
MAX_IMAGE_PAGES=1
IMAGE_DPI=150
JPEG_QUALITY=78
