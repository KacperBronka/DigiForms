# Runtime only. Copy to .env and fill in locally; never commit real secrets.
EDENAI_API_KEY=
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
MAX_UPLOAD_BYTES=20971520
DOCUMENT_PROCESSOR_TIMEOUT_MS=270000
EDENAI_MODEL=gemma-4-31b-it
EDENAI_READ_TIMEOUT_SECONDS=180
# Enable to require caller JWT on upload endpoints.
JWT_ENABLED=false
JWT_ALGORITHM=HS256
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
# Per-IP sustained request rates and additional burst capacity at nginx.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
UPLOAD_RATE_LIMIT_RPM=5
UPLOAD_RATE_LIMIT_BURST=2

# Processing limits (single API/worker process per container).
MAX_ACTIVE_JOBS=1
MAX_QUEUED_JOBS=2
QUEUE_TIMEOUT_SECONDS=15
JOB_TIMEOUT_SECONDS=240
WORKER_TIMEOUT_SECONDS=180
MAX_DOCUMENT_PAGES=30
MAX_IMAGE_PIXELS=20000000
MAX_TOTAL_PIXELS=100000000
MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_BYTES=104857600
MAX_ARCHIVE_RATIO=100
MAX_SANITIZED_BYTES=67108864
SANITIZE_DPI=150
API_CPUS=1.0
API_MEMORY=512m
WORKER_CPUS=2.0
WORKER_MEMORY=4g
FRONTEND_CPUS=1.0
FRONTEND_MEMORY=512m
PROXY_CPUS=0.5
PROXY_MEMORY=128m

LOG_LEVEL=INFO
