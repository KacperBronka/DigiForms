# Runtime only. Copy to .env locally and provide your own key; never commit .env.
EDENAI_API_KEY=
MAX_UPLOAD_BYTES=20971520
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
PARSER_TMP_SIZE=1g
APP_HOME_SIZE=64m

# Eden AI integration (runtime only)
EDENAI_API_URL=https://api.edenai.run/v3/chat/completions
EDENAI_MODEL=amazon/anthropic.claude-haiku-5-5@eu
EDENAI_CONNECT_TIMEOUT_SECONDS=15
EDENAI_READ_TIMEOUT_SECONDS=600

# JWT verification. No signing private key is needed by this application.
JWT_ENABLED=false
JWT_ALGORITHM=RS256
JWT_ISSUER=
JWT_AUDIENCE=
# PEM public key; literal backslash-n sequences are accepted between lines.
JWT_PUBLIC_KEY=
JWT_LEEWAY_SECONDS=30

# OCR and model input limits
OCR_LANG=pl
MAX_OCR_CHARS=160000
MAX_IMAGE_PAGES=5
IMAGE_DPI=150
JPEG_QUALITY=78

# NVIDIA OCR: docker compose -f compose.yaml -f compose.nvidia.yaml up --build
# Rebuild after changing OCR_LANG to bundle the corresponding EasyOCR weights.
OCR_DPI=200
# Tesseract CPU worker settings
OCR_THREADS=4
OCR_TIMEOUT_SECONDS=120
# Outside Docker, optionally specify the local model directory for the selected engine.
OCR_MODELS_DIR=
